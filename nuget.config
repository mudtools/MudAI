<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <!-- 单一源（方案 §5.2）：Mud.AI 新仓一律从 nuget.org 还原。
             本地闭环（D-5）只发生在消费侧（飞书仓 nuget.config 的可选本地 folder 源），
             新仓自身的还原基线不认任何本地源。 -->
    </packageSources>
</configuration>
